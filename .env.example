# Copia este archivo como .env.local (en tu PC) o carga estas variables en Vercel → Settings → Environment Variables.

# URL pública del sitio. En Vercel se detecta sola; úsala solo si conectas un dominio propio.
NEXT_PUBLIC_SITE_URL=

# --- Timing en vivo (opcional) ---
# Cuenta de pago de OpenF1 (https://openf1.org). Sin esto, /live muestra la repetición de la última carrera.
OPENF1_USERNAME=
OPENF1_PASSWORD=
# Solo para pruebas: fuerza el modo en vivo con una sesión pasada (p. ej. 11377). Déjalo vacío en producción.
OPENF1_LIVE_SESSION_KEY=

# --- Valoraciones de los fans (opcional) ---
# Supabase → Project Settings → API. La service role key es secreta: solo va en el servidor.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Texto aleatorio largo para anonimizar a los votantes (genera uno con: openssl rand -hex 32)
RATINGS_SALT=

# --- Imágenes oficiales ---
# Pon "false" para dejar de usar fotos/coches/logos oficiales de F1 (se usan Wikimedia y siluetas propias).
NEXT_PUBLIC_OFFICIAL_MEDIA=true
